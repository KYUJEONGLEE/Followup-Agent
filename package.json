{
  "name": "AI Agent 실습",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "9.x"
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "api:build": "pnpm --filter @followup-agent/api build",
    "agent:verify": "pnpm --filter @followup-agent/api agent:verify",
    "api:lint": "pnpm --filter @followup-agent/api lint",
    "api:start": "pnpm --filter @followup-agent/api start",
    "api:start:dev": "pnpm --filter @followup-agent/api start:dev",
    "api:test": "pnpm --filter @followup-agent/api test",
    "api:test:e2e": "pnpm --filter @followup-agent/api test:e2e",
    "api:test:integration": "pnpm --filter @followup-agent/api test:integration",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs postgres",
    "db:migrate": "pnpm --filter @followup-agent/api database:migrate",
    "db:migration:show": "pnpm --filter @followup-agent/api database:migration:show",
    "db:revert": "pnpm --filter @followup-agent/api database:revert",
    "db:seed": "pnpm --filter @followup-agent/api database:seed",
    "db:up": "docker compose up -d --wait postgres",
    "db:verify": "pnpm --filter @followup-agent/api database:verify",
    "web:build": "pnpm --filter @followup-agent/web build",
    "web:dev": "pnpm --filter @followup-agent/web dev",
    "web:lint": "pnpm --filter @followup-agent/web lint",
    "web:test": "pnpm --filter @followup-agent/web test",
    "test": "pnpm api:test",
    "test:e2e": "pnpm api:test:e2e",
    "test:integration": "pnpm api:test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "dotenv": "^17.4.2",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
