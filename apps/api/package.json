{
  "name": "@followup-agent/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "agent:verify": "ts-node -r tsconfig-paths/register src/agent/verify-agent-workflow.ts",
    "database:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "database:migrate:prod": "typeorm migration:run -d dist/database/data-source.js",
    "database:migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "database:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "database:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "database:seed:prod": "node dist/database/seed.js",
    "database:verify": "ts-node -r tsconfig-paths/register src/database/verify-seed.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "start": "nest start",
    "start:deploy": "pnpm database:migrate:prod && pnpm database:seed:prod && pnpm start:prod",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "test:integration": "jest --config test/jest-integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.12",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "openai": "7.5.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
